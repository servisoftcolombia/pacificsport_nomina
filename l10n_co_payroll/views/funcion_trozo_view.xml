<?xml version="1.0" encoding="utf-8"?>
<odoo>
            
    <record id="funcion_trozo_view_form" model="ir.ui.view">
        <field name="name">funcion.trozo.view.form</field>
        <field name="model">funcion.trozo</field>
        <field name="arch" type="xml">
            <form string="Porcentajes incapacidades">
                <sheet>
                    <group name="nombre">
                        <field name="nombre"/>
                    </group>
                    <group name="detalle">
                        <div class="o_td_label">
                            <label for="funcion_trozo_detalle_ids" string="Rango de porcentajes para liquidar las incapacidades"/>
                        </div>
                        <field name="funcion_trozo_detalle_ids" widget="one2many_list" nolabel="1">
                            <list editable="bottom">
                                <field name="desde" widget="integer"/>
                                <field name="hasta" widget="integer"/>
                                <field name="valor_inicial" string="Valor %"/>
                                <field name="valor_adicional"/>
                            </list>
                         </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="funcion_trozo_detalle_view_form" model="ir.ui.view">
        <field name="name">funcion.trozo.detalle.view.form</field>
        <field name="model">funcion.trozo.detalle</field>
        <field name="arch" type="xml">
            <form string="Funcion Trozo Detalle">
                <sheet>
                    <group name="funcion_trozo">
                        <field name="funcion_trozo_id"/>
                    </group>
                    <group name="values" string="Valores">
                        <group name="range">
                            <field name="desde" widget="integer"/>
                            <field name="hasta" widget="integer"/>
                        </group>
                        <group name="valor">
                            <field name="valor_inicial" string="Valor %"/>
                            <field name="valor_adicional"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

</odoo>