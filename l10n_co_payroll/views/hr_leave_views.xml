<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_view_form_manager_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.manager.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form_manager"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="contract_manager" invisible="1"/>
                <field name="contract_id" domain="[('employee_id','=',employee_id.id)]" readonly="contract_manager == False" required="1" force_save="1"/>
            </xpath> 

            <!-- Label and days description for number_of_days_calendar -->
            <xpath expr="//field[@name='name']" position="before">
                <field name="work_entry_type_code" invisible="1"></field>
                <div class="o_td_label">
                    <label for="work_entry_type_code" string="Dias Calendario" invisible="work_entry_type_code != 'LICMP'"/>
                </div>
                <div>
                    <field name="number_of_days_calendar" class="oe_inline" nolabel="1"
                        invisible="work_entry_type_code != 'LICMP'"/>
                    <span class="ml8" invisible="work_entry_type_code != 'LICMP'">Dias</span>
                </div>
            </xpath>

        </field>
    </record>

    <record id="hr_leave_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.view.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='holiday_status_id']" position="after">
                    <field name="contract_manager" invisible="1"/>
                    <label class="col-2 mr-0" for="contract_id"/>
                    <field name="contract_id" domain="[('employee_id','=',employee_id.id)]" readonly="contract_manager == False" context="{'contract_id':contract_id.id}" class="col-9 pl-0" nolabel="1" required="1" force_save="1"/>
            </xpath>

        </field>
    </record>

</odoo>
