<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_hr_leave_allocation_inherit" model="ir.ui.view">
        <field name="name">hr.leave.allocation.inherit.form</field>
        <field name="model">hr.leave.allocation</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_allocation_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='employee_id']" position="after">
                <field name="work_entry_type_code" invisible="1"/>
                <field name="contract_manager" invisible="1"/>
                <field name="contract_id" domain="[('employee_id','=',employee_id.id)]" readonly="contract_manager == False" required="1" force_save="1"/>
                <field name="anticipated_vacations" invisible="work_entry_type_code != 'VAC'"/>
			</xpath>
            <xpath expr="//field[@name='allocation_type']" position="attributes">
                <attribute name="readonly">['|', ('state', 'not in', ['confirm']), ('work_entry_type_code', '=', 'VAC')]</attribute>
                <attribute name="required">1</attribute>
                <!-- Force save the value if field is readonly -->
                <attribute name="force_save">1</attribute>
            </xpath>

            <xpath expr="//field[@name='number_of_days_display']" position="attributes">
                <attribute name="readonly">['|', ('type_request_unit', '=', 'hour'), ('state', 'not in', ['confirm', 'validate'])]</attribute>
                <attribute name="invisible">[('type_request_unit', '=', 'hour')]</attribute>
            </xpath>

            <xpath expr="//field[@name='holiday_status_id']" position="attributes">
                <!--Se añade al contexto al seleccionar este campo el id del contrato-->
                <attribute name="context">{'employee_id': employee_id.id, 'contract_id': contract_id.id}</attribute>
            </xpath>

        </field>
    </record>


</odoo>
