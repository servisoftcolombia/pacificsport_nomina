<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="res_company_form__l10n_co_view_for" model="ir.ui.view">
            <field name="name">Datos de la Empresa - Colombia</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="priority">30</field>
            <field name="arch" type="xml">
                <data>
                    <xpath expr="//page[1]" position="after">
                        <page string="Información Nómina">
                            <sheet>
                                <group string="Información Nómina">
                                    <group name="info1">
                                        <field name="ccf_id"/>
                                        <field name="arl_id"/>
                                        <field name="icbf_id"/>
                                        <field name="sena_id"/>
                                        <field name="dian_id"/>
                                        <field name="ley_1607" help="La empresa está acogida a la ley 1607 de 2012? (Exención en pago de Parafiscales SENA e ICBF y Salud)"/>
                                        <field name="pcts_incapacidades"/>
                                    </group>
                                    <group name="info2">
                                        <div class="o_td_label">
                                            <label for="anticipated_vacation_limit" string="Limite vacaciones anticipadas"/>
                                        </div>
                                        <div>
                                            <field name="anticipated_vacation_limit" class="oe_inline" nolabel="1"/>
                                            <span class="ml8" invisible="anticipated_vacation_limit == 0">Dias</span>
                                        </div>
                                    </group>
                                </group>

                                <div name="calculation_settings" class="app_settings_block settings">
                                    <div class="o_horizontal_separator shadow-sm p-3 bg-white rounded" name="calculation_settings_label">Configuraciones para los cálculos</div>
                                    <div name="prima_settings">
                                        <div class="o_horizontal_separator" name="prima_settings_label">Prima</div>
                                        <field name="licenses_as_suspension" class="oe_inline" nolabel="1"/>
                                        <label for="licenses_as_suspension" string="Para el pago de la prima no tener en cuenta los dias de licencia no remunerada"/>
                                        <br/>
                                        <field name="vacations_in_average" class="oe_inline" nolabel="1"/>
                                        <label for="vacations_in_average" string="Tomar vacaciones en los promedios para la base de la prima"/>
                                        <br/>
                                        <field name="all_aux_tra_in_average_fixed_salary" class="oe_inline" nolabel="1"/>
                                        <label for="all_aux_tra_in_average_fixed_salary" string="Para salario fijo tomar el auxilio de transporte completo en el cálculo del promedio para la prima, y no solo lo pagado"/>
                                        <br/>
                                        <field name="all_aux_tra_in_average_variable_salary" class="oe_inline" nolabel="1"/>
                                        <label for="all_aux_tra_in_average_variable_salary" string="Para salario variable tomar el auxilio de transporte completo en el cálculo del promedio para la prima, y no solo lo pagado"/>
                                        <br/>
                                        <field name="average_in_fixed_salary" class="oe_inline" nolabel="1"/>
                                        <label for="average_in_fixed_salary" string="Para salario fijo la base para el calculo de la prima se realiza con el promedio"/>
                                        <br/>
                                        <field name="disability_one_hundred_average_fixed_salary" class="oe_inline" nolabel="1"/>
                                        <label for="disability_one_hundred_average_fixed_salary" string="Para salario fijo tomar los días de incapacidad al 100% en el cálculo del promedio para la prima, y no solo lo pagado"/>
                                        <br/>
                                        <field name="disability_one_hundred_average_variable_salary" class="oe_inline" nolabel="1"/>
                                        <label for="disability_one_hundred_average_variable_salary" string="Para salario variable tomar los días de incapacidad al 100% en el cálculo del promedio para la prima, y no solo lo pagado"/>
                                    </div>
                                    <div name="cesantias_settings">
                                        <div class="o_horizontal_separator" name="cesantias_settings_label">Cesantias</div>
                                        <field name="all_aux_tra_in_severance_fixed_salary" class="oe_inline" nolabel="1"/>
                                        <label for="all_aux_tra_in_severance_fixed_salary" string="Para salario fijo tomar el auxilio de transporte completo en el cálculo cesantias, y no solo lo pagado"/>
                                        <br/>
                                        <field name="all_aux_tra_in_severance_variable_salary" class="oe_inline" nolabel="1"/>
                                        <label for="all_aux_tra_in_severance_variable_salary" string="Para salario variable tomar el auxilio de transporte completo en el cálculo cesantias, y no solo lo pagado"/>
                                        <br/>
                                        <field name="last_salary_in_severance_fixed_salary" class="oe_inline" nolabel="1"/>
                                        <label for="last_salary_in_severance_fixed_salary" string="Para salario fijo tomar siempre el último salario en el cálculo de las cesantías"/>
                                    </div>
                                    <div name="vacaciones_settings">
                                        <div class="o_horizontal_separator" name="Vacaciones_settings_label">Vacaciones</div>
                                        <field name="vacations_in_average_of_vacations" class="oe_inline" nolabel="1"/>
                                        <label for="vacations_in_average_of_vacations" string="Tomar vacaciones en los promedios para la base de vacaciones"/>
                                        <br/>
                                        <field name="vacations_salary_base_as_average" class="oe_inline" nolabel="1"/>
                                        <label for="vacations_salary_base_as_average" string="Para promediar el pago de las vacaciones se toma el último salario devengado"/>
                                    </div>
                                    <div name="others_settings">
                                        <div class="o_horizontal_separator" name="others_settings_label">Otros</div>
                                        <field name="limit_40_percent_parafiscal_base" class="oe_inline" nolabel="1"/>
                                        <label for="limit_40_percent_parafiscal_base" string="Calcular límite del 40% a los pagos no constitutivos de salario en la base de parafiscales"/>
                                    </div>
                                </div>
                            </sheet>
                        </page>
                    </xpath>
                </data>
            </field>
        </record>

    </data>
</odoo>

